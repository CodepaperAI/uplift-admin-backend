  refundAmountCents    Int    @default(0)
  netAmountCents       Int    @default(0)
  platformShareCents   Int    @default(0)
  agencyShareCents     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([settlementRunId])
  @@index([businessId])
  @@map("agency_settlement_line_item")
}

model AdminAuditLog {
  id          String @id @default(uuid())
  adminUserId String
  adminUser   User   @relation("AdminAuditLogs", fields: [adminUserId], references: [id], onDelete: Cascade)

  action     String
  targetType String
  targetId   String
  details    Json?
  before     Json?
  after      Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([adminUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_log")
}

model CommandRoleCapability {
  id         String  @id @default(uuid())
  role       Role
  capability String
  enabled    Boolean @default(true)

  updatedByUserId String?
  updatedByUser   User?   @relation("CommandCapabilityUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, capability])
  @@index([role, enabled])
  @@map("command_role_capability")
}

model CommandRepProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation("CommandRepProfileUser", fields: [userId], references: [id], onDelete: Cascade)

  name                String
  basePay             Decimal?                       @db.Decimal(19, 4)
  currency            String?
  ghlUserId           String?                        @unique
  startDate           DateTime
  endDate             DateTime?
  isActive            Boolean                        @default(true)
  activities          CommandRepActivity[]
  accounts            CommandAccount[]
  assignments         CommandGhlLeadAssignment[]
  dealCredits         CommandDealCredit[]
  commissionLines     CommandCommissionLine[]
  commissionSnapshots CommandCommissionRepSnapshot[]
  calls               CommandCall[]
  coachingBriefs      CommandCoachingBrief[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([startDate])
  @@index([endDate])
  @@map("command_rep_profile")
}

/// Canonical customer identity used by the Command Panel. Stripe and GHL
/// remain provider truth; this projection joins their stable ids to one owner.
model CommandAccount {
  id               String             @id @default(uuid())
  name             String
  normalizedEmail  String?            @unique
  stripeCustomerId String?            @unique
  ghlContactId     String?            @unique
  ownerRepId       String?
  ownerRep         CommandRepProfile? @relation(fields: [ownerRepId], references: [id], onDelete: SetNull)
  userId           String?
  businessId       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  calls            CommandCall[]

  @@index([ownerRepId])
  @@index([userId])
  @@index([businessId])
  @@map("command_account")
}

model CommandRepActivity {
  id              String            @id @default(uuid())
  repId           String
  rep             CommandRepProfile @relation(fields: [repId], references: [id], onDelete: Cascade)
  periodMonth     String
  calls           Int               @default(0)
  connects        Int               @default(0)
  meetingsBooked  Int               @default(0)
  meetingsHeld    Int               @default(0)
  source          String            @default("manual")
  updatedByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([repId, periodMonth, source])
  @@index([periodMonth, source])
  @@index([repId, periodMonth])
  @@map("command_rep_activity")
}

model CommandService {
  id                   String                      @id @default(uuid())
  key                  String                      @unique
  name                 String
  kind                 String
  listPriceMinor       Decimal?                    @db.Decimal(19, 0)
  currency             String?
  stripePriceIds       String[]
  ghlPipelineIds       String[]
  ghlCustomFieldValues String[]
  isActive             Boolean                     @default(true)
  createdByUserId      String?
  updatedByUserId      String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  rateVersions         CommandServiceRateVersion[]
  dealCredits          CommandDealCredit[]
  commissionLines      CommandCommissionLine[]

  @@index([kind, isActive])
  @@index([isActive, name])
  @@map("command_service")
}

/// Effective-dated, owner-approved operating decisions. A new version is
/// appended instead of mutating an approved historical decision.
model CommandDecision {
  id                 String    @id @default(uuid())
  key                String
  category           String
  version            Int
  status             String    @default("draft")
  value              Json
  requiresLegal      Boolean   @default(false)
  legalConfirmedAt   DateTime?
  legalConfirmedById String?
  approvedAt         DateTime?
  approvedByUserId   String?
  effectiveAt        DateTime
  retiredAt          DateTime?
  notes              String?
  createdByUserId    String
  updatedByUserId    String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([key, version])
  @@index([key, status, effectiveAt])
  @@index([status, effectiveAt])
  @@map("command_decision")
}

/// Commission rates are versioned independently from list prices. Rates are
/// decimal ratios (0.5 = 50%) and are selected by the source deal start date.
model CommandServiceRateVersion {
  id               String                  @id @default(uuid())
  serviceId        String
  service          CommandService          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  firstSaleRate    Decimal                 @db.Decimal(9, 6)
  recurringRate    Decimal                 @db.Decimal(9, 6)
  status           String                  @default("draft")
  approvedAt       DateTime?
  approvedByUserId String?
  createdByUserId  String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  commissionLines  CommandCommissionLine[]

  @@unique([serviceId, effectiveFrom])
  @@index([serviceId, status, effectiveFrom])
  @@map("command_service_rate_version")
}

/// First-observed GHL assignment history. It never fabricates an assignment
/// date that predates Command ingestion, so cohort coverage remains explicit.
model CommandGhlLeadAssignment {
  id                String                @id @default(uuid())
  ghlOpportunityId  String
  opportunity       CommandGhlOpportunity @relation(fields: [ghlOpportunityId], references: [ghlOpportunityId], onDelete: Cascade)
  assignedToGhlId   String?
  repId             String?
  rep               CommandRepProfile?    @relation(fields: [repId], references: [id], onDelete: SetNull)
  observedFrom      DateTime
  observedTo        DateTime?
  sourceSyncRunId   String?
  providerUpdatedAt DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([ghlOpportunityId, observedFrom])
  @@index([repId, observedFrom])
  @@index([assignedToGhlId, observedFrom])
  @@index([observedTo])
  @@map("command_ghl_lead_assignment")
}

/// Explicit deal-credit allocations support the owner-selected single-owner
/// or split-credit policy without rewriting provider assignment facts.
model CommandDealCredit {
  id               String            @id @default(uuid())
  sourceType       String
  sourceId         String
  serviceId        String?
  service          CommandService?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  repId            String
  rep              CommandRepProfile @relation(fields: [repId], references: [id], onDelete: Restrict)
  creditShare      Decimal           @db.Decimal(9, 6)
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  status           String            @default("approved")
  approvedByUserId String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([sourceType, sourceId, repId, effectiveFrom])
  @@index([sourceType, sourceId, status])
  @@index([repId, effectiveFrom])
  @@map("command_deal_credit")
}

/// One monthly calculation container. Configuration is snapshotted before a
/// run can be locked so later policy/rate changes cannot alter payroll history.
model CommandCommissionRun {
  id                    String                         @id @default(uuid())
  periodMonth           String                         @unique
  status                String                         @default("open")
  configurationSnapshot Json
  sourceFactsThrough    DateTime
  calculatedAt          DateTime                       @default(now())
  calculatedByUserId    String
  lockedAt              DateTime?
  lockedByUserId        String?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  lines                 CommandCommissionLine[]
  repSnapshots          CommandCommissionRepSnapshot[]

  @@index([status, periodMonth])
  @@map("command_commission_run")
}

/// Exact, currency-separated earned/held/released/adjustment facts. lineKey is
/// the idempotency key across recalculation and provider replay.
model CommandCommissionLine {
  id                String                     @id @default(uuid())
  lineKey           String                     @unique
  runId             String
  run               CommandCommissionRun       @relation(fields: [runId], references: [id], onDelete: Restrict)
  repId             String
  rep               CommandRepProfile          @relation(fields: [repId], references: [id], onDelete: Restrict)
  serviceId         String?
  service           CommandService?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  rateVersionId     String?
  rateVersion       CommandServiceRateVersion? @relation(fields: [rateVersionId], references: [id], onDelete: SetNull)
  kind              String
  status            String
  sourceType        String
  sourceId          String
  originPeriodMonth String
  postedPeriodMonth String
  amountMinor       Decimal                    @db.Decimal(19, 4)
  currency          String
  metadata          Json?
  createdAt         DateTime                   @default(now())

  @@index([runId, repId, currency])
  @@index([repId, postedPeriodMonth])
  @@index([sourceType, sourceId])
  @@index([status, postedPeriodMonth])
  @@map("command_commission_line")
}

/// Locked rep-period totals including draw balance reconciliation. Stored
/// snapshots make historical reports deterministic and fast.
model CommandCommissionRepSnapshot {
  id                      String               @id @default(uuid())
  runId                   String
  run                     CommandCommissionRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  repId                   String
  rep                     CommandRepProfile    @relation(fields: [repId], references: [id], onDelete: Restrict)
  currency                String
  firstSaleMinor          Decimal              @db.Decimal(19, 4)
  recurringMinor          Decimal              @db.Decimal(19, 4)
  clawbackMinor           Decimal              @db.Decimal(19, 4)
  heldMinor               Decimal              @db.Decimal(19, 4)
  releasedMinor           Decimal              @db.Decimal(19, 4)
  adjustmentMinor         Decimal              @db.Decimal(19, 4)
  earnedMinor             Decimal              @db.Decimal(19, 4)
  baseDrawMinor           Decimal              @db.Decimal(19, 4)
  drawDifferentialMinor   Decimal              @db.Decimal(19, 4)
  openingDrawBalanceMinor Decimal              @db.Decimal(19, 4)
  closingDrawBalanceMinor Decimal              @db.Decimal(19, 4)
  cashPayableMinor        Decimal              @db.Decimal(19, 4)
  closesNeeded            Int?
  createdAt               DateTime             @default(now())

  @@unique([runId, repId, currency])
  @@index([repId, currency, runId])
  @@map("command_commission_rep_snapshot")
}

/// Provider facts stay immutable. Approved overrides are separate rows whose
/// scope and precedence are explicit and fully auditable.
model CommandDataOverride {
  id               String    @id @default(uuid())
  provider         String
  entityType       String
  entityId         String
  field            String
  value            Json
  reason           String
  status           String    @default("approved")
  effectiveAt      DateTime
  expiresAt        DateTime?
  approvedByUserId String
  createdByUserId  String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([provider, entityType, entityId, field, status])
  @@index([effectiveAt, expiresAt])
  @@map("command_data_override")
}

/// A normalized call envelope. Raw transcripts are deliberately not stored;
/// only provider references, bounded notes/summary and retention metadata live
/// in the application database.
model CommandCall {
  id                  String              @id @default(uuid())
  provider            String
  providerCallId      String
  lastProviderEventId String?
  repId               String?
  rep                 CommandRepProfile?  @relation(fields: [repId], references: [id], onDelete: SetNull)
  accountId           String?
  account             CommandAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  title               String?
  startedAt           DateTime
  durationSeconds     Int?
  participantEmails   String[]
  organizerEmail      String?
  summary             String?
  actionItems         Json?
  transcriptUrl       String?
  recordingUrl        String?
  consentState        String              @default("provider_managed")
  reviewStatus        String              @default("pending")
  retentionExpiresAt  DateTime?
  providerPayloadHash String
  providerCreatedAt   DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  reviews             CommandCallReview[]

  @@unique([provider, providerCallId])
  @@index([repId, startedAt])
  @@index([accountId, startedAt])
  @@index([reviewStatus, startedAt])
  @@index([retentionExpiresAt])
  @@map("command_call")
}

/// Durable provider-event claim. Fathom reuses webhook-id when it retries and
/// Fireflies is namespaced by its stable event/timestamp/meeting identity.
model CommandCallWebhookEvent {
  id             String    @id
  status         String    @default("processing")
  attemptCount   Int       @default(1)
  leaseExpiresAt DateTime?
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, leaseExpiresAt])
  @@map("command_call_webhook_event")
}

model CommandCallReview {
  id            String      @id @default(uuid())
  callId        String
  call          CommandCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  status        String      @default("completed")
  score         Decimal?    @db.Decimal(5, 2)
  rubric        Json?
  strengths     Json?
  improvements  Json?
  missedSignal  String?
  focus         String?
  nextActions   Json?
  errorCode     String?
  model         String
  promptVersion String
  inputHash     String
  generatedAt   DateTime    @default(now())
  createdAt     DateTime    @default(now())

  @@unique([callId, model, promptVersion, inputHash])
  @@index([callId, generatedAt])
  @@index([status, generatedAt])
  @@map("command_call_review")
}

model CommandCoachingBrief {
  id            String            @id @default(uuid())
  repId         String
  rep           CommandRepProfile @relation(fields: [repId], references: [id], onDelete: Cascade)
  periodMonth   String
  status        String            @default("completed")
  reviewCount   Int
  payload       Json?
  errorCode     String?
  model         String
  promptVersion String
  inputHash     String
  generatedAt   DateTime          @default(now())
  createdAt     DateTime          @default(now())

  @@unique([repId, periodMonth, model, promptVersion, inputHash])
  @@index([repId, periodMonth, generatedAt])
  @@index([status, generatedAt])
  @@map("command_coaching_brief")
}

model SuperAdminSalesRecord {
  id              String   @id @default(uuid())
  salespersonName String
  amountCents     Int
  currency        String   @default("USD")
  note            String?
  recordedAt      DateTime @default(now())

  createdByUserId String
  createdByUser   User   @relation("SuperAdminSalesRecords", fields: [createdByUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

