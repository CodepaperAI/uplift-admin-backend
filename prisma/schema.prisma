// DR Growth Engine Models

enum DRActionType {
  CONTENT_OPTIMIZATION
  GUEST_POST_PITCH
  LINK_RECLAIM
  INTERNAL_LINK
}

enum DRActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED
}

model DRActionLog {
  id          String         @id @default(uuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessDR  Int? // Snapshot of DR at action time
  actionType  DRActionType
  status      DRActionStatus @default(PENDING)
  details     Json?
  error       String?
  retryCount  Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  completedAt DateTime?

  @@index([businessId])
  @@index([actionType])
  @@index([status])
  @@index([createdAt])
}

model DRContentOptimization {
  id               String         @id @default(uuid())
  businessId       String
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  blogId           String
  blog             Blog           @relation(fields: [blogId], references: [id], onDelete: Cascade)
  externalPostId   String? // WordPress post ID
  optimizationType String // "stats_section", "embeddable_snippet", "structured_data", "sources_section"
  contentBefore    String?        @db.Text // Original content hash or excerpt for tracking
  contentAdded     String?        @db.Text // What was added/modified
  drRangeStrategy  String? // "foundational" (0-10), "data_driven" (10-30), "authority" (30+)
  status           DRActionStatus @default(PENDING)
  error            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([businessId])
  @@index([blogId])
  @@index([status])
}

enum DROutreachStatus {
  DRAFTED
  SENT
  OPENED
  REPLIED
  ACCEPTED
  REJECTED
  NEEDS_REVIEW
  EXPIRED
}

model DROutreachCampaign {
  id                  String            @id @default(uuid())
  businessId          String
  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  publisherDomain     String
  publisherEmail      String?
  publisherDA         Float? // Domain authority at time of pitch
  status              DROutreachStatus  @default(DRAFTED)
  pitchSubject        String?
  pitchContent        String?           @db.Text
  proposedTopic       String?
  inboundReplyAddress String? // reply-{businessId}@inbound.upliftai.co
  sentAt              DateTime?
  openedAt            DateTime?
  respondedAt         DateTime?
  responseContent     String?           @db.Text
  guestPostBlogId     String? // Blog ID if guest post was created
  cooldownUntil       DateTime? // Don't re-pitch until this date
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  emails              DROutreachEmail[]

  @@index([businessId])
  @@index([status])
  @@index([publisherDomain])
  @@index([cooldownUntil])
}

enum DROutreachEmailType {
  PITCH
  FOLLOWUP
  RECLAIM
}

model DROutreachEmail {
  id             String              @id @default(uuid())
  campaignId     String
  campaign       DROutreachCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  emailType      DROutreachEmailType
  recipientEmail String
  subject        String
  body           String              @db.Text
  resendEmailId  String? // Resend message ID for tracking
  sentAt         DateTime?
  openedAt       DateTime?
  repliedAt      DateTime?
  bounced        Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([campaignId])
  @@index([resendEmailId])
}

enum DRLinkRecoveryStatus {
  DETECTED
  ANALYZING
  RECOVERABLE
  NOT_RECOVERABLE
  EMAILED
  RECOVERED
  ABANDONED
}

model DRLinkRecovery {
  id              String               @id @default(uuid())
  businessId      String
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  backlinkId      String? // Reference to ExternalBacklink.id
  sourceUrl       String // The URL that had the backlink
  sourceDomain    String
  targetUrl       String // The URL that was linked to
  domainAuthority Float? // DA of the referring domain at time of loss
  lostAt          DateTime
  reason          String? // "page_removed", "link_removed", "nofollow_changed", "domain_expired", "redirect_issue"
  reclaimStatus   DRLinkRecoveryStatus @default(DETECTED)
  reclaimEmailId  String? // Reference to DROutreachEmail if a reclaim was sent
  analyzedAt      DateTime?
  recoveredAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([businessId])
  @@index([reclaimStatus])
  @@index([sourceDomain])
  @@index([lostAt])
}

// ============================================
// AI Visibility Models - GEO / LLM Citation Tracking
// ============================================

enum LlmProvider {
  CHATGPT
  GEMINI
  PERPLEXITY
  CLAUDE
}

enum ContentRouteType {
  GOOGLE
  LLM
  DUAL
}

enum LlmQueryDifficulty {
  EASY
  MEDIUM
  HARD
}

enum LlmQuerySource {
  PAA
  LLM_EXPANSION
}

model LlmCitationScan {
  id              String        @id @default(uuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  triggeredAt     DateTime      @default(now())
  completedAt     DateTime?
  status          String        @default("pending") // pending, running, completed, partial, failed
  keywordsScanned Int           @default(0)
  citations       LlmCitation[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([businessId])
  @@index([status])
  @@index([triggeredAt])
}

model LlmCitation {
  id               String          @id @default(uuid())
  scanId           String
  scan             LlmCitationScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  businessId       String
  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  keyword          String
  query            String // The natural language query sent to the LLM
  llmProvider      LlmProvider
  citedCount       Int             @default(0) // How many times out of totalRuns the domain was cited
  totalRuns        Int             @default(3) // Number of runs per scan for this query
  cited            Boolean         @default(false) // Convenience: citedCount > 0
  citedUrl         String? // The specific URL that was cited (if URL match)
  citationContext  String? // The sentence/paragraph around the citation
  competitorsCited Json? // Array of {domain, url, context} for competitors found in the response
  createdAt        DateTime        @default(now())

  @@index([businessId, keyword, llmProvider, createdAt])
  @@index([scanId])
  @@index([businessId, createdAt])
}

model LlmQueryDiscovery {
  id              String             @id @default(uuid())
  businessId      String
  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  keyword         String // The seed keyword
  discoveredQuery String // The inferred question people ask AI
  source          LlmQuerySource
  difficulty      LlmQueryDifficulty @default(MEDIUM)
  estimatedVolume Int? // Google search volume via DataForSEO as proxy
  category        String? // Topic group

  // Phase 2: prioritization signals
  priorityScore Float     @default(0) // 0–1 composite score
  lastScoredAt  DateTime?
  targeted      Boolean   @default(false) // true once blog generation has been enqueued

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, keyword])
  @@index([businessId, priorityScore(sort: Desc)])
}

model ContentLlmScore {
  id                  String   @id @default(uuid())
  blogId              String   @unique
  blog                Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  businessId          String
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  overallScore        Int      @default(0) // 0-10
  schemaMarkup        Int      @default(0) // 0-2
  faqSection          Int      @default(0) // 0-2
  sourceCitations     Int      @default(0) // 0-2
  definitionalClarity Int      @default(0) // 0-2
  freshness           Int      @default(0) // 0-2
  suggestions         Json? // Array of {signal, message, priority}
  lastScored          DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([businessId])
  @@index([overallScore])
}

model AiVisibilityJob {
  id                String    @id @default(uuid())
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestedByUserId String?
  requestedBy       User?     @relation("AiVisibilityJobRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  type              String
  source            String    @default("manual")
  periodKey         String?
  status            String    @default("pending")
  progress          Int       @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  lastError         String?
  result            Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([businessId, type, periodKey])
  @@index([businessId, type, createdAt])
  @@index([businessId, type, status])
  @@index([type, periodKey, status])
  @@index([status])
  @@index([requestedByUserId])
}

model AiVisibilityTrialRun {
  id                String   @id @default(uuid())
  businessId        String   @unique
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestedByUserId String?
  requestedBy       User?    @relation("AiVisibilityTrialRunRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  status            String   @default("queued")
  citationJobId     String?
  discoveryJobId    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([requestedByUserId])
  @@index([status])
}

model CompetitiveGap {
  id               String    @id @default(uuid())
  businessId       String
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  keyword          String
  competitorUrl    String
  competitorDomain String
  // Normalized outline: [{ level: "H1"|"H2"|"H3", text: string, hasFaq: boolean }]
  outline          Json
  // Topics competitors cover that our own content (if any) doesn't:
  // [{ topic: string, citedByProviders: ["CHATGPT", ...] }]
  gapTopics        Json
  detectedAt       DateTime  @default(now())
  resolvedAt       DateTime?
  resolvedByBlogId String?

  @@index([businessId, keyword])
  @@index([businessId, detectedAt])
  @@index([businessId, resolvedAt])
}

model BusinessAnalyticsConfig {
  id                String    @id @default(uuid())
  businessId        String    @unique
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ga4PropertyId     String?
  // Encrypted service-account JSON blob or reference to a secret manager.
  // The raw value never leaves the backend; encryption is handled by the
  // upsert helper, never by direct writes.
  serviceAccountRef String?
  connectedAt       DateTime?
  lastSyncedAt      DateTime?
  lastSyncError     String?
  gscSiteUrl        String?
  gscAccessToken    String?
  gscRefreshToken   String?
  gscConnectedAt    DateTime?
  gscLastSyncedAt   DateTime?
  gscLastSyncError  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model AiReferralTraffic {
  id              String   @id @default(uuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  source          String // e.g. chatgpt.com, perplexity.ai, gemini.google.com, claude.ai
  sessions        Int      @default(0)
  engagedSessions Int      @default(0)
  conversions     Int      @default(0)
  blogUrl         String?
  createdAt       DateTime @default(now())

  @@unique([businessId, date, source, blogUrl])
  @@index([businessId, date])
  @@index([businessId, source])
}

model SearchConsoleMetric {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  query       String   @default("")
  page        String   @default("")
  device      String   @default("")
  country     String   @default("")
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, date, query, page, device, country])
  @@index([businessId, date])
  @@index([businessId, query])
  @@index([businessId, page])
}

model ContentRoute {
  id         String           @id @default(uuid())
  blogId     String           @unique
  blog       Blog             @relation(fields: [blogId], references: [id], onDelete: Cascade)
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  route      ContentRouteType @default(DUAL)
  confidence Float            @default(0.5) // 0-1, heuristic confidence
  reason     String? // Human-readable explanation shown in UI
  assignedAt DateTime         @default(now())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([businessId])
  @@index([route])
}

// Framer Marketplace plugin handshake rows.
// Created on POST /api/public/v1/framer-plugin/authorize,
// updated when the user completes signup (frontend posts to /handshake),
// consumed + deleted on POST /api/v1/framer-plugin/connect.
//
// Expired rows are removed on the next Framer authorize request.
// pluginNonceHash binds the readKey to the originating plugin instance
// so an attacker who sees a readKey can't poll it from a different plugin.
model FramerPluginHandshake {
  readKey            String   @id
  readKeyDigest      String?
  pluginNonceHash    String
  exchangeCode       String?  @unique
  exchangeCodeDigest String?
  userId             String?
  createdAt          DateTime @default(now())
  expiresAt          DateTime

  @@index([expiresAt])
  @@index([userId])
}

// Off-page strategy engine: per-business status of an opportunity in the queue.
// No FK relation (keeps it decoupled from the Business model); keyed by a stable
// opportunityKey so status survives queue re-computation.
model OffPageOpportunity {
  id                 String    @id @default(uuid())
  businessId         String
  opportunityKey     String
  leverKey           String
  status             String    @default("todo") // todo | in_progress | done | dismissed
  // Outcome verification: confirm the user's posted Reddit thread / claimed
  // directory listing is actually live (not blind-trust the "done" toggle).
  verificationStatus String? // unverified | verifying | verified | not_found | failed
  verifiedAt         DateTime?
  evidenceUrl        String? // user-provided post/listing URL to verify
  evidence           Json? // what the verifier found (matched NAP, post author, etc.)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([businessId, opportunityKey])
  @@index([businessId])
}

// Off-page research cache: the validated + live-enriched opportunity set per
// business. The multi-agent pipeline (planner → researchers → validator) plus
// the live checks (Reddit threads, directory reachability + already-listed) is
// expensive, so it runs once per business and is served from here until the TTL
// expires or the user forces a refresh. inputHash fingerprints the business
// inputs so a changed profile invalidates the cache.
model OffPageResearchCache {
  id          String   @id @default(uuid())
  businessId  String   @unique
  inputHash   String
  payload     Json // validated + enriched opportunities (full queue)
  generatedAt DateTime @default(now())
  expiresAt   DateTime

  @@index([businessId])
  @@map("off_page_research_cache")
}
