// ============================================
// WordPress OAuth Token Model
// ============================================

model WordPressOAuthToken {
  id               String @id @default(uuid())
  userId           String // Database User ID
  wordpressSiteUrl String // WordPress site URL

  // OAuth tokens (encrypted)
  accessToken    String
  refreshToken   String?
  tokenExpiresAt DateTime?

  // Connection info
  isActive    Boolean   @default(true)
  connectedAt DateTime  @default(now())
  lastUsedAt  DateTime?

  // Plugin metadata
  pluginVersion    String?
  wordpressVersion String?

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  PublishingIntegration PublishingIntegration[]

  @@unique([userId, wordpressSiteUrl])
  @@index([userId])
  @@index([wordpressSiteUrl])
  @@index([isActive])
}

