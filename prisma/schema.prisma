// Phase 2 ranking foundations — edit→rank impact attribution.
// One row per (action, phase). 'baseline' captures rank state at approval;
// 'post' captures rank state 14 days later. The pair feeds the impact UI.
model GMBEditImpactSnapshot {
  id               String           @id @default(uuid())
  businessId       String
  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  gmbId            String
  googleMyBusiness GoogleMyBusiness @relation(fields: [gmbId], references: [id], onDelete: Cascade)

  actionId   String
  action     GMBActionRecommendation @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actionType String // copied at capture so we can group/filter without joining
  phase      String // "baseline" | "post"
  capturedAt DateTime                @default(now())

  // Array of { keyword, locationLabel, position, rankAbsolute, scanId } — taken from
  // the most recent COMPLETE GMBLocalRankScan rows at capture time. JSON for
  // forward-compat (deltas computed on read).
  rankSnapshot Json

  // Filled in on the 'post' row by the evaluator. Null until evaluation runs.
  deltaSummary Json? // { keywordsImproved, keywordsDeclined, avgPositionDelta, topMoves: [...] }
  evaluatedAt  DateTime?

  @@unique([actionId, phase])
  @@index([businessId, capturedAt])
  @@index([phase, capturedAt])
}

