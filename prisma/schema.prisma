/// Business's chosen GMB categories. Primary + up to 9 secondary per GBP rules.
/// categoryId references the static taxonomy in src/lib/data/gmb-categories.json
/// (e.g., "gcid:plumber"). displayName cached for UI to avoid catalog lookups.
model GMBCategory {
  id               String           @id @default(uuid())
  businessId       String
  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  gmbId            String
  googleMyBusiness GoogleMyBusiness @relation(fields: [gmbId], references: [id], onDelete: Cascade)

  categoryId  String // Official GBP category id, e.g. "gcid:plumber"
  displayName String // Cached human-readable name from catalog
  isPrimary   Boolean @default(false) // Exactly one primary per business expected
  order       Int     @default(0) // Display ordering for secondary categories

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, categoryId])
  @@index([gmbId])
  @@index([businessId, isPrimary])
}

/// Business attribute values (e.g., wheelchair_accessible_entrance, has_wifi,
/// payment methods). Attribute definitions live in src/lib/data/gmb-attributes.json.
/// Value is stored in the column matching the attribute's valueType.
model GMBAttribute {
  id               String           @id @default(uuid())
  businessId       String
  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  gmbId            String
  googleMyBusiness GoogleMyBusiness @relation(fields: [gmbId], references: [id], onDelete: Cascade)

  attributeId String // Official GBP attribute id, e.g. "has_wheelchair_accessible_entrance"
  displayName String // Cached human label from catalog
  valueType   String // BOOL | ENUM | URL | REPEATED_ENUM
  boolValue   Boolean? // populated when valueType = BOOL
  enumValue   String? // populated when valueType = ENUM (single selection)
  urlValue    String? // populated when valueType = URL
  enumValues  String[] // populated when valueType = REPEATED_ENUM (multi-select)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, attributeId])
  @@index([gmbId])
}

/// BusinessPhoto (D14) — customer-uploaded real photos. Used as preferred
/// image source for service-page archetype blogs when present (AI-generated
/// images fall back to the role of gap-filler). Drives meaningful E-E-A-T
/// improvement for local businesses.
enum BusinessPhotoCategory {
  EXTERIOR
  INTERIOR
  TEAM
  PRODUCT
  WORK_SAMPLE
  OTHER
}

model BusinessPhoto {
  id             String                @id @default(uuid())
  businessId     String
  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url            String // Cloudinary delivery URL
  altText        String?
  category       BusinessPhotoCategory @default(OTHER)
  order          Int                   @default(0)
  width          Int?
  height         Int?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  gmbMediaAssets GMBMediaAsset[]

  @@index([businessId, order])
  @@index([businessId, category])
}

/// ServiceAreaGeoHint (D12) — lightweight per-service-city geocoding. Each
/// row is a city the business serves but doesn't have a physical location in.
/// Stores only coordinates + canonical city/state/country; no landmarks, no
/// Place ID collision worries — city centroids are permanent. Used by the
/// blog generator when a blog targets a service-area keyword ("plumber
/// Mississauga") so the prompt can reference verified city-level geography.
model ServiceAreaGeoHint {
  id               String   @id @default(uuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cityName         String // user-provided city name (preserved for display)
  canonicalCity    String? // normalized city name from Places API
  state            String?
  countryCode      String? // ISO-3166 alpha-2
  latitude         Float?
  longitude        Float?
  placeId          String? // locality-level Place ID, not business-level
  resolved         Boolean  @default(false)
  lastResolveError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, cityName])
  @@index([businessId])
  @@index([canonicalCity])
}

/// BusinessGeoProfile — canonical location data derived from Google Maps Places
/// API (New) v1. One-to-one with Business. Permanent fields (placeId,
/// coordinates, addressComponents) cached indefinitely per Google ToS;
/// ephemeral POI data (nearbyLandmarksJson) refreshed every 30 days by the
/// businessGeoPoiRefresh cron. Quality fields populate without Maps calls.
model BusinessGeoProfile {
  id         String   @id @default(uuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // --- Permanent (indefinite cache allowed per Google ToS) ---
  placeId           String? @unique
  formattedAddress  String?
  latitude          Float?
  longitude         Float?
  plusCode          String?
  googleMapsUri     String?
  addressComponents Json?
  streetNumber      String?
  route             String?
  neighborhood      String? // sublocality_level_1
  locality          String? // city
  adminArea2        String? // metro/county
  adminArea1        String? // state/province
  postalCode        String?
  countryCode       String? // ISO-3166 alpha-2
  viewportJson      Json?

  // --- Resolution state ---
  resolutionSource     String @default("user_confirmed") // user_confirmed | gmb_sync | auto | manual
  resolutionConfidence Float?
  alternateCandidates  Json?

  // --- Ephemeral (30-day TTL per Google ToS) ---
  nearbyLandmarksJson Json?
  areaPOIsJson        Json?
  poisRefreshedAt     DateTime?
  poisTTLDays         Int       @default(30)

  // --- Quality / status (computed without Maps calls; used for dashboard nudge) ---
  qualityScore    Int      @default(0)
  missingFields   String[]
  recommendations Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placeId])
  @@index([countryCode, locality])
  @@index([poisRefreshedAt])
}

model GMBPost {
