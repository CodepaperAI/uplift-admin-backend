  id               String           @id @default(uuid())
  businessId       String
  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  gmbId            String
  googleMyBusiness GoogleMyBusiness @relation(fields: [gmbId], references: [id], onDelete: Cascade)

  dayOfWeek    Int // 0 = Sunday ... 6 = Saturday
  openTime     String? // "HH:mm" 24h - null when closed/24h
  closeTime    String? // "HH:mm" 24h - null when closed/24h
  isClosed     Boolean @default(false) // Explicit "closed all day" - distinct from "no hours set"
  is24Hours    Boolean @default(false) // Open continuously
  segmentOrder Int     @default(0) // 0 = primary segment, 1 = afternoon segment (split hours)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, dayOfWeek, segmentOrder])
  @@index([gmbId])
}

