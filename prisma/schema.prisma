// Persistent cache for AI-generated GBP profile proposals. Proposal output is
// keyed by the SHA-256 hash of the input fields (business name, type,
// description, services, location, etc.) so identical inputs always produce
// identical output without hitting the LLM. Survives deploys (unlike the
// in-process map). When a business edits its profile, the input hash
// changes and the next read regenerates.
model GMBProfileProposalCache {
  id         String   @id @default(uuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  inputHash    String
  proposalJson Json

  generatedAt DateTime @default(now())
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inputHash])
  @@index([expiresAt])
}

// Cache for Google's businessInformation categories.list resolutions. Maps a
// (regionCode, normalized displayName) pair to the resolved categories/gcid:*
// resource ID. Google's category taxonomy is stable for weeks, so a 30-day
// TTL is plenty. Used by the runtime category resolver as a layer between
// the static map and the live API call.
model GMBCategoryCacheEntry {
  id         String    @id @default(uuid())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  // Normalized lookup key — lowercase displayName (no punctuation) joined
  // with the regionCode and languageCode used at lookup time.
  cacheKey String @unique

  regionCode   String
  languageCode String
  displayName  String
  // Resolved Google resource ID, or null when Google returned no match.
  // Storing null lets us cache misses too without re-hammering the API.
  resourceId   String?

  generatedAt DateTime @default(now())
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@index([businessId])
}

