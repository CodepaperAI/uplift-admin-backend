model ExternalBacklink {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Target information
  targetUrl    String // URL being analyzed
  targetDomain String // Domain being analyzed

  // Source information (from DataForSEO)
  sourceUrl        String // URL where backlink is found
  sourceDomain     String // Domain where backlink originates
  sourceDomainRank Int? // Domain authority/rank
  sourceDomainType String? // "root_domain", "subdomain", etc.

  // Link attributes
  anchorText   String? // Anchor text used
  anchorType   String? // "exact", "partial", "branded", "generic"
  linkType     String? // "dofollow", "nofollow", "sponsored", "ugc"
  linkPosition String? // "footer", "header", "content", "sidebar"

  // Quality metrics
  domainAuthority Float? // Domain authority score (0-100)
  pageAuthority   Float? // Page authority score (0-100)
  spamScore       Float? // Spam score (0-100, lower is better)
  trustScore      Float? // Trust score
  citationFlow    Float? // Citation flow metric
  trustFlow       Float? // Trust flow metric

  // DataForSEO metadata
  backlinkId String? // DataForSEO backlink ID
  firstSeen  DateTime? // When backlink was first discovered
  lastSeen   DateTime? // When backlink was last seen
  lostAt     DateTime? // When backlink was lost (if applicable)
  isLost     Boolean   @default(false)

  // Status
  status      String  @default("active") // "active", "lost", "new", "reviewed"
  isReviewed  Boolean @default(false)
  reviewNotes String?

  // Timestamps
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastSyncedAt DateTime? // Last time synced from DataForSEO

  @@unique([businessId, sourceUrl, targetUrl])
  @@index([businessId])
  @@index([targetDomain])
  @@index([sourceDomain])
  @@index([status])
  @@index([isLost])
  @@index([targetUrl])
  @@index([sourceUrl])
}

