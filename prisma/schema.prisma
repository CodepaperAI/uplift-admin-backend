generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
  AGENCY_ADMIN
  SALES
}

model User {
  id       String     @id @default(uuid())
  email    String     @unique
  business Business[]

  onboarding      Boolean @default(false)
  backlinkEnabled Boolean @default(true)

  // 🆕 NEW: Keyword generation status tracking
  keywordGenerationStatus      String    @default("idle") // "idle", "pending", "processing", "completed", "failed"
  keywordGenerationStartedAt   DateTime?
  keywordGenerationCompletedAt DateTime?

  // 🆕 NEW: Trial system tracking
  trialStartDate DateTime?
  trialEndDate   DateTime?
  trialStatus    String?   @default("none") // "none", "active", "expired", "converted"
  trialUsed      Boolean   @default(false) // Prevent multiple trials

  // 🆕 NEW: Phone number for trial enrollment
  phone String?

  termsAcceptedAt       DateTime?
  termsVersion          String?
  privacyAcceptedAt     DateTime?
  privacyVersion        String?
  legalConsentIp        String?
  legalConsentUserAgent String?

  role Role @default(USER)

  // Explicit opt-in for the internal Command Panel. SUPERADMIN bypasses this
  // gate; normal product users must never gain internal access by role alone.
  commandPanelEnabled Boolean @default(false)
  twoFactorEnabled    Boolean @default(false)

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  businessId String?
  Blog       Blog[]
  BlogLinks  SitemapUrls[]
  Plan       Plan[]

  WordPressintegration           WordPressintegration?
  Subscription                   Subscription?
  PublishingIntegrations         PublishingIntegration[]   @relation("PublishingIntegrations")
  GuestPostPublishers            GuestPostPublisher[]
  GuestPostCampaigns             GuestPostCampaign[]
  GuestPostSubmissions           GuestPostSubmission[]
  name                           String
  emailVerified                  Boolean                   @default(false)
  image                          String?
  sessions                       Session[]
  accounts                       Account[]
  ApiTokens                      ApiToken[]                @relation("ApiTokens")
  SeoAuditRuns                   SeoAuditRun[]             @relation("SeoAuditRuns")
  AgencyMemberships              AgencyMembership[]        @relation("UserAgencyMemberships")
  AdminAuditLogs                 AdminAuditLog[]           @relation("AdminAuditLogs")
  SuperAdminSalesRecords         SuperAdminSalesRecord[]   @relation("SuperAdminSalesRecords")
  SalesCustomerAssignments       SalesCustomerAssignment[] @relation("SalespersonAssignments")
  SalesCustomerNotes             SalesCustomerNote[]       @relation("SalesNotesAuthor")
  SalesEntries                   SalesEntry[]              @relation("SalesEntriesSalesperson")
  LlmUsageEvents                 LlmUsageEvent[]           @relation("LlmUsageEventsUser")
  SocialCreativeRuns             SocialCreativeRun[]       @relation("SocialCreativeRunsUser")
  SocialTopicPlans               SocialTopicPlan[]
  LegacySocialPosts              SocialPost[]
  ContentClusters                ContentCluster[]
  RequestedAiVisibilityJobs      AiVisibilityJob[]         @relation("AiVisibilityJobRequestedBy")
  RequestedAiVisibilityTrialRuns AiVisibilityTrialRun[]    @relation("AiVisibilityTrialRunRequestedBy")
  RewardfulAttribution           RewardfulAttribution?
  CommandRepProfile              CommandRepProfile?        @relation("CommandRepProfileUser")
  CommandCapabilityUpdates       CommandRoleCapability[]   @relation("CommandCapabilityUpdatedBy")
  TwoFactor                      TwoFactor?

  @@map("user")
}

model Subscription {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId            String?
  planName          String?
  status            String
  startDate         DateTime
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime?

  stripeCustomerId        String?   @unique
  stripeSubscriptionId    String?   @unique
  stripePriceId           String?
  stripeCurrentPeriodEnd  DateTime?
  stripeCancelAtPeriodEnd Boolean   @default(false)
  stripeStatus            String?

  // 🆕 NEW: Multi-website support
  websiteCount Int @default(1) // Number of active websites
  maxWebsites  Int @default(1) // Maximum websites allowed in plan

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model WebsiteSubscription {
  id         String   @id @default(uuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  stripeSubscriptionId     String?
  stripeSubscriptionItemId String?         @unique
  stripePriceId            String?
  planTier                 WebsitePlanTier @default(SEO)

  // Downgrades retain the current paid entitlement until Stripe moves the
  // subscription schedule into its next phase. Provider identifiers remain
  // backend-only and are never returned by the billing status API.
  stripePlanScheduleId     String?
  scheduledPlanPriceId     String?
  scheduledPlanTier        WebsitePlanTier?
  scheduledBillingInterval String?
  scheduledPlanChangeAt    DateTime?

  status             String    @default("active") // active, trialing, canceled, past_due, suspended, expired
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  trialStartDate DateTime?
  trialEndDate   DateTime?
  trialStatus    String    @default("none") // none, trialing, expired, converted

  agencyId              String?
  agency                Agency?              @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  agencyPricingConfigId String?
  agencyPricingConfig   AgencyPricingConfig? @relation(fields: [agencyPricingConfigId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trialStatus, trialEndDate])
  @@index([status])
  @@index([agencyId])
  @@index([stripePlanScheduleId])
  @@index([scheduledPlanChangeAt])
}

model StripeWebhookEvent {
  id             String    @id
  status         String    @default("processed")
  attemptCount   Int       @default(1)
  leaseExpiresAt DateTime?
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, leaseExpiresAt])
  @@map("stripe_webhook_event")
}

model StripeBillingEvent {
  id                   String   @id @default(uuid())
  stripeEventId        String   @unique
  eventType            String
  stripeObjectId       String?
  stripeObjectType     String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripeInvoiceId      String?
  stripeChargeId       String?
  stripeRefundId       String?
  userId               String?
  businessId           String?
  amountCents          Int?
  refundedAmountCents  Int?
  currency             String   @default("usd")
  refundStatus         String?
  refundReason         String?
  accessAction         String   @default("none")
  metadata             Json?
  payload              Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([eventType])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([stripeInvoiceId])
  @@index([stripeChargeId])
  @@index([stripeRefundId])
  @@index([userId])
  @@index([businessId])
  @@index([accessAction])
  @@index([createdAt])
  @@map("stripe_billing_event")
}

/// Read-only Stripe invoice projection used by the Command Panel. Amounts are
/// exact provider minor units; currency determines their display exponent.
model CommandStripeInvoice {
  id                   String    @id @default(uuid())
  stripeInvoiceId      String    @unique
  lastStripeEventId    String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  userId               String?
  businessId           String?
  status               String
  billingReason        String?
  collectionMethod     String?
  amountDueMinor       Decimal   @default(0) @db.Decimal(19, 0)
  amountPaidMinor      Decimal   @default(0) @db.Decimal(19, 0)
  amountRemainingMinor Decimal   @default(0) @db.Decimal(19, 0)
  currency             String
  attemptCount         Int       @default(0)
  periodStart          DateTime?
  periodEnd            DateTime?
  paidAt               DateTime?
  providerCreatedAt    DateTime
  hostedInvoiceUrl     String?
  invoicePdf           String?
  source               String    @default("webhook")
  lastSyncedAt         DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([userId])
  @@index([businessId])
  @@index([status, paidAt])
  @@index([periodStart, periodEnd])
  @@map("command_stripe_invoice")
}

/// Append-only subscription lifecycle facts. The Stripe event id is the
/// provider idempotency key, so a replay cannot create a second fact.
model CommandStripeSubscriptionEvent {
  id                      String    @id @default(uuid())
  stripeEventId           String    @unique
  eventType               String
  stripeSubscriptionId    String
  stripeCustomerId        String?
  userId                  String?
  businessId              String?
  status                  String
  pauseCollectionBehavior String?
  cancelAtPeriodEnd       Boolean   @default(false)
  stripePriceIds          String[]
  monthlyRecurringMinor   Decimal   @default(0) @db.Decimal(19, 4)
  currency                String?
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  occurredAt              DateTime
  metadata                Json?
  createdAt               DateTime  @default(now())

  @@index([stripeSubscriptionId, occurredAt], map: "cmd_stripe_sub_event_subscription_time_idx")
  @@index([userId, occurredAt])
  @@index([businessId, occurredAt])
  @@index([status])
  @@index([occurredAt])
  @@map("command_stripe_subscription_event")
}

/// Current provider state for each Stripe subscription. Lifecycle history stays
/// append-only in CommandStripeSubscriptionEvent; this projection keeps Command
/// dashboard reads bounded and indexable at production volume.
model CommandStripeSubscriptionSnapshot {
  stripeSubscriptionId    String    @id
  lastStripeEventId       String    @unique
  eventType               String
  stripeCustomerId        String?
  userId                  String?
  businessId              String?
  status                  String
  pauseCollectionBehavior String?
  cancelAtPeriodEnd       Boolean   @default(false)
  stripePriceIds          String[]
  monthlyRecurringMinor   Decimal   @default(0) @db.Decimal(19, 4)
  currency                String?
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  occurredAt              DateTime
  metadata                Json?
  updatedAt               DateTime  @updatedAt

  @@index([status, pauseCollectionBehavior], map: "cmd_stripe_snapshot_status_pause_idx")
  @@index([stripeCustomerId])
  @@index([userId])
  @@index([businessId])
  @@index([currency])
  @@index([occurredAt])
  @@map("command_stripe_subscription_snapshot")
}

model CommandProviderSyncRun {
  id          String    @id @default(uuid())
  provider    String
  mode        String
  status      String    @default("running")
  inspected   Int       @default(0)
  created     Int       @default(0)
  updated     Int       @default(0)
  unchanged   Int       @default(0)
  corrections Json?
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([provider, startedAt])
  @@index([status])
  @@map("command_provider_sync_run")
}

/// Precomputed provider-derived metrics keep the leadership dashboard bounded
/// at production volume. The source facts remain append-only and authoritative.
model CommandStripeMonthlyRollup {
  periodMonth String   @id
  payload     Json
  generatedAt DateTime
  updatedAt   DateTime @updatedAt

  @@index([generatedAt])
  @@map("command_stripe_monthly_rollup")
}

model CommandGhlContact {
  id                String    @id @default(uuid())
  ghlContactId      String    @unique
  locationId        String
  name              String?
  email             String?
  phone             String?
  country           String?
  source            String?
  assignedToGhlId   String?
  tags              String[]
  customFields      Json?
  providerCreatedAt DateTime?
  providerUpdatedAt DateTime?
  isActive          Boolean   @default(true)
  lastSyncedAt      DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([locationId])
  @@index([assignedToGhlId])
  @@index([source])
  @@index([isActive])
  @@map("command_ghl_contact")
}

model CommandGhlOpportunity {
  id                 String                     @id @default(uuid())
  ghlOpportunityId   String                     @unique
  locationId         String
  ghlContactId       String?
  name               String
  monetaryValue      Decimal?                   @db.Decimal(19, 4)
  currency           String?
  pipelineId         String
  pipelineName       String?
  pipelineStageId    String
  pipelineStageName  String?
  pipelineStageIndex Int?
  furthestStageId    String?
  furthestStageName  String?
  furthestStageIndex Int?
  assignedToGhlId    String?
  status             String
  source             String?
  lostReasonId       String?
  lastStatusChangeAt DateTime?
  lastStageChangeAt  DateTime?
  lastActionAt       DateTime?
  providerCreatedAt  DateTime?
  providerUpdatedAt  DateTime?
  expectedCloseDate  DateTime?
  isActive           Boolean                    @default(true)
  lastSyncedAt       DateTime                   @default(now())
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  assignmentHistory  CommandGhlLeadAssignment[]

  @@index([locationId])
  @@index([ghlContactId])
  @@index([pipelineId, pipelineStageId])
  @@index([assignedToGhlId])
  @@index([status])
  @@index([providerCreatedAt])
  @@index([isActive])
  @@index([isActive, assignedToGhlId, lastActionAt], map: "cmd_ghl_opp_active_owner_action_idx")
  @@index([isActive, status])
  @@index([isActive, source, status])
  @@map("command_ghl_opportunity")
}

model CommandGhlPaymentSubscription {
  id                       String    @id @default(uuid())
  ghlSubscriptionRecordId  String    @unique
  providerSubscriptionId   String?
  locationId               String
  contactId                String?
  contactName              String?
  contactEmail             String?
  amount                   Decimal?  @db.Decimal(19, 4)
  currency                 String?
  status                   String
  liveMode                 Boolean?
  entityType               String?
  entityId                 String?
  entitySourceType         String?
  entitySourceName         String?
  entitySourceId           String?
  paymentProviderType      String?
  paymentProviderAccountId String?
  providerCreatedAt        DateTime?
  providerUpdatedAt        DateTime?
  isActive                 Boolean   @default(true)
  lastSyncedAt             DateTime  @default(now())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([providerSubscriptionId])
  @@index([locationId])
  @@index([contactId])
  @@index([status, liveMode])
  @@index([currency])
  @@index([providerCreatedAt])
  @@index([isActive])
  @@map("command_ghl_payment_subscription")
}

model CommandGhlPaymentTransaction {
  id                       String    @id @default(uuid())
  ghlTransactionId         String    @unique
  locationId               String
  contactId                String?
  contactName              String?
  contactEmail             String?
  amount                   Decimal?  @db.Decimal(19, 4)
  amountRefunded           Decimal?  @db.Decimal(19, 4)
  currency                 String?
  status                   String
  liveMode                 Boolean?
  providerSubscriptionId   String?
  chargeId                 String?
  entityType               String?
  entityId                 String?
  entitySourceType         String?
  entitySourceSubType      String?
  entitySourceName         String?
  entitySourceId           String?
  paymentProviderType      String?
  paymentProviderAccountId String?
  fulfilledAt              DateTime?
  providerCreatedAt        DateTime?
  providerUpdatedAt        DateTime?
  isActive                 Boolean   @default(true)
  lastSyncedAt             DateTime  @default(now())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([providerSubscriptionId])
  @@index([locationId])
  @@index([contactId])
  @@index([status, liveMode])
  @@index([currency, fulfilledAt])
  @@index([paymentProviderType])
  @@index([isActive])
  @@map("command_ghl_payment_transaction")
}

model CommandCostEntry {
  id               String    @id @default(uuid())
  category         String
  costCategory     String
  vendor           String
  source           String    @default("manual")
  amountMinor      Decimal   @db.Decimal(19, 0)
  currency         String
  description      String
  occurredAt       DateTime
  sourceExternalId String?   @unique
  createdByUserId  String?
  updatedByUserId  String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([category, occurredAt])
  @@index([costCategory, occurredAt])
  @@index([vendor, occurredAt])
  @@index([source, occurredAt])
  @@index([currency, occurredAt])
  @@index([deletedAt])
  @@map("command_cost_entry")
}

model RewardfulAttribution {
  id                      String    @id @default(uuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralId              String?   @unique
  via                     String?
  affiliateId             String?
  affiliateToken          String?
  affiliateName           String?
  affiliateFirstName      String?
  affiliateLastName       String?
  campaignId              String?
  campaignName            String?
  couponId                String?
  couponName              String?
  landingUrl              String?
  capturedAt              DateTime  @default(now())
  lastSeenAt              DateTime  @default(now())
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  stripeCheckoutSessionId String?
  conversionEmail         String?
  conversionTrackedAt     DateTime?
  raw                     Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([affiliateId])
  @@index([affiliateToken])
  @@index([campaignId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([createdAt])
  @@map("rewardful_attribution")
}

model RewardfulWebhookEvent {
  id                   String    @id @default(uuid())
  eventId              String    @unique
  eventType            String
  objectId             String?
  objectType           String?
  referralId           String?
  affiliateId          String?
  saleId               String?
  commissionId         String?
  payoutId             String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  amountCents          Int?
  currency             String?
  status               String?
  processingStatus     String    @default("received")
  processingError      String?
  retryCount           Int       @default(0)
  lastRetriedAt        DateTime?
  payload              Json
  deliveryCount        Int       @default(1)
  receivedAt           DateTime  @default(now())
  processedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([eventType])
  @@index([objectId])
  @@index([referralId])
  @@index([affiliateId])
  @@index([saleId])
  @@index([commissionId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([processingStatus])
  @@index([receivedAt])
  @@map("rewardful_webhook_event")
}

enum KeywordType {
  MUST_HAVE
  NICE_TO_HAVE
}

enum OnboardingFlow {
  trial_primary
  website_secondary
}

enum OnboardingStatus {
  idle
  queued
  running
  awaiting_confirmation
  failed
  completed
}

model Keywords {
  id          String      @id @default(uuid())
  keyword     String
  keywordType KeywordType
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  Business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId  String
}

model CompetitiveAdvantage {
  id         String   @id @default(uuid())
  advantage  String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
}

model Competitors {
  id         String   @id @default(uuid())
  name       String
  url        String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
}

model currentRanking {
  id         String   @id @default(uuid())
  website    String
  ranking    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
}

model QuickScrapeBusiness {
  id                        String    @id @default(uuid())
  userId                    String
  businessName              String
  businessType              String
  businessWebsiteUrl        String
  detectedServices          String[]  @default([])
  selectedServices          String[]  @default([])
  servicesPriority          Json?
  businessAddress           String?
  businessCity              String?
  businessState             String?
  businessCountry           String?
  businessPhone             String?
  serviceArea               String?
  serviceAreaLocations      String[]  @default([])
  businessLocationMode      String?
  confirmedPlaceId          String?
  contactDetailsConfirmedAt DateTime?

  // Onboarding v2 persists the one-time Context.dev snapshot so services,
  // blog generation, and social generation all reuse the same source facts.
  businessDescription String?
  targetAudience      String?
  brandContext        Json?

  // Resumable onboarding progress. These fields are intentionally additive
  // so records created before the canonical flow remain compatible.
  onboardingV2Flow                OnboardingFlow   @default(trial_primary)
  onboardingV2Step                String           @default("website")
  onboardingV2QuestionIndex       Int              @default(0)
  onboardingV2Answers             Json?
  onboardingV2AnswerRevision      Int              @default(0)
  onboardingV2Status              String           @default("in_progress")
  onboardingV2LastSeenAt          DateTime?
  onboardingV2GenerationStartedAt DateTime?
  onboardingV2GenerationRevision  Int?
  onboardingV2BusinessId          String?
  onboardingV2BlogId              String?
  onboardingV2SocialRunId         String?
  onboardingV2BlogStatus          String           @default("idle")
  onboardingV2SocialStatus        String           @default("idle")
  onboardingV2GenerationError     Json?
  onboardingV2Author              Json?
  onboardingV2CompletedAt         DateTime?
  onboardingV2SelectedPlanTier    WebsitePlanTier?

  quickKeywords            Json?
  quickKeywordsGenerating  Boolean   @default(false)
  quickKeywordsGeneratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, businessWebsiteUrl])
  @@index([userId, onboardingV2Status, onboardingV2LastSeenAt], map: "qsb_user_v2_status_seen_idx")
  @@index([userId, onboardingV2Flow, onboardingV2Status, onboardingV2LastSeenAt], map: "qsb_user_v2_flow_status_seen_idx")
  @@map("quick_scrape_business")
}

model TrialAnalytics {
  id     String @id @default(uuid())
  userId String @unique

  // Onboarding metrics
  onboardingStartedAt    DateTime  @default(now())
  onboardingCompletedAt  DateTime?
  quickScrapeCompletedAt DateTime?
  servicesSelectedAt     DateTime?
  trialEnrolledAt        DateTime?

  // Engagement metrics
  firstLoginAt    DateTime?
  lastLoginAt     DateTime?
  totalLogins     Int       @default(0)
  dashboardVisits Int       @default(0)
  blogsViewed     Int       @default(0)
  keywordsViewed  Int       @default(0)

  // Content metrics
  firstBlogGeneratedAt   DateTime?
  totalBlogsGenerated    Int       @default(0)
  totalKeywordsGenerated Int       @default(0)

  // Conversion metrics
  upgradeCTAClicked   Int       @default(0)
  pricingPageVisited  Int       @default(0)
  checkoutStarted     Boolean   @default(false)
  checkoutCompletedAt DateTime?
  converted           Boolean   @default(false)
  convertedAt         DateTime?

  // A/B Testing
  abTestVariant String? // "control", "variant_a", "variant_b"
  abTestGroup   String? // "modal_design", "pricing_display", etc.

  // Email engagement
  welcomeEmailSent       Boolean   @default(false)
  welcomeEmailOpenedAt   DateTime?
  firstBlogEmailSent     Boolean   @default(false)
  firstBlogEmailOpenedAt DateTime?
  expiringEmailSent      Boolean   @default(false)
  expiringEmailOpenedAt  DateTime?
  expiredEmailSent       Boolean   @default(false)
  expiredEmailOpenedAt   DateTime?

  // Trial outcome
  trialEndedAt       DateTime?
  trialOutcome       String? // "converted", "expired", "cancelled"
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trial_analytics")
}

model Business {
  id                  String  @id @default(uuid())
  businessName        String
  businessType        String
  businessDescription String
  businessWebsiteUrl  String
  businessPhone       String?

  // Geographic Information
  businessAddress      String?
  businessCity         String?
  businessState        String?
  businessCountry      String?
  serviceArea          String? // local, regional, national, international
  // 🆕 NEW: Service area locations (cities/areas where business operates)
  serviceAreaLocations String[] // Array of city names within service area for location-based keyword generation

  // Target Audience & Content Preferences
  targetAudience        String?
  contentTone           String? // professional, casual, technical, friendly
  publishingFrequency   String? // daily, weekly, bi-weekly, monthly
  publishDaysOfWeek     Int[]    @default([0, 1, 2, 3, 4, 5, 6]) // 0=Sun..6=Sat; which days to schedule blogs
  preferredContentTypes String[] // guides, reviews, news, tutorials, case-studies, how-to
  blogImagesEnabled     Boolean  @default(true) // Generate featured and in-article images for new blogs
  // 🆕 NEW: Multilanguage preferences
  defaultLanguage       String?  @default("en") // User's preferred default language (backward compatibility)
  supportedLanguages    String[] // Array of language codes user wants to support
  // 🆕 NEW: Locale preferences
  defaultLocale         String?  @default("en-US") // User's preferred default locale (e.g., "en-CA", "fr-CA", "en-US")
  // 🆕 NEW: Example blog URLs for content style reference
  exampleBlogUrls       String[] // Array of example blog URLs (max 5) from user's website

  // 🆕 NEW: Service selection from quick scrape (30-second onboarding)
  detectedServices Json? // AI-detected services from quick scrape
  selectedServices String[] @default([]) // User-selected services to target
  servicesPriority Json? // {service: priority} mapping for ranking focus

