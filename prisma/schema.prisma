model PublishingIntegration {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation("PublishingIntegrations", fields: [userId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business? @relation("PublishingIntegrations", fields: [businessId], references: [id], onDelete: Cascade)

  platform    ConnectionPlatform
  isActive    Boolean            @default(true)
  autoPublish Boolean            @default(false)
  publishAs   PublishAs          @default(PUBLISH)

  // WordPress (backward compatibility - REST API)
  wordpressUrl      String?
  wordpressUsername String?
  wordpressPassword String?

  // WordPress Plugin OAuth (NEW)
  wordpressConnectionMethod String?              @default("REST_API") // "REST_API" | "PLUGIN"
  wordpressOAuthTokenId     String? // Reference to WordPressOAuthToken
  wordpressOAuthToken       WordPressOAuthToken? @relation(fields: [wordpressOAuthTokenId], references: [id], onDelete: SetNull)

  // WordPress Integration Key (NEW)
  wordpressIntegrationKey               String?   @unique // Unique key for plugin authentication
  wordpressIntegrationKeyDigest         String?   @unique // HMAC digest for inbound verification
  wordpressPreviousKeyDigest            String? // Previous HMAC digest retained only for forensic fingerprinting
  wordpressIntegrationKeyFirstCreatedAt DateTime? // First key issuance for this integration
  wordpressIntegrationKeyCreatedAt      DateTime? // When key was generated
  wordpressIntegrationKeyLastUsedAt     DateTime? // Last time key was used
  wordpressIntegrationKeyRevokedAt      DateTime? // When the current key was revoked
  wordpressIntegrationKeyRotationCount  Int       @default(0)
  pluginVersion                         String? // WordPress plugin version reported during test connection

  // Webflow (backward compatibility - API Key)
  webflowSiteId       String?
  webflowApiKey       String?
  webflowCollectionId String?

  // Webflow OAuth (NEW)
  webflowConnectionMethod String?            @default("API_KEY") // "API_KEY" | "OAUTH"
  webflowOAuthTokenId     String? // Reference to WebflowOAuthToken
  webflowOAuthToken       WebflowOAuthToken? @relation(fields: [webflowOAuthTokenId], references: [id], onDelete: SetNull)

  // Shopify (backward compatibility - API Key)
  shopifyShopDomain           String?
  shopifyAccessToken          String?
  shopifyClientId             String?
  shopifyClientSecret         String?
  shopifyAccessTokenIssuedAt  DateTime?
  shopifyAccessTokenExpiresAt DateTime?
  shopifyApiVersion           String?   @default("2026-01")
  shopifyBlogId               String?

  // Shopify App OAuth (NEW)
  shopifyConnectionMethod String?            @default("OAUTH") // "API_KEY" | "OAUTH" | "CUSTOM_APP"
  shopifyOAuthTokenId     String? // Reference to ShopifyOAuthToken
  shopifyOAuthToken       ShopifyOAuthToken? @relation(fields: [shopifyOAuthTokenId], references: [id], onDelete: SetNull)
  shopifyApiMethod        String?            @default("GRAPHQL") // "REST" | "GRAPHQL"

  // Framer
  framerProjectId      String?
  framerApiKey         String?
  framerCollectionName String?

  // Custom API
  customApiUrl             String?
  customApiKey             String?
  customApiSecret          String?
  customApiMethod          String? @default("POST")
  customApiAuthType        String? @default("bearer")
  customApiHeaders         Json?
  customApiPayloadMapping  Json?
  customApiResponseMapping Json?

  // Wix OAuth (Wix requires OAuth 2.0)
  wixSiteId           String?
  wixConnectionMethod String?        @default("OAUTH") // "OAUTH" only (Wix requires OAuth)
  wixOAuthTokenId     String? // Reference to WixOAuthToken
  wixOAuthToken       WixOAuthToken? @relation(fields: [wixOAuthTokenId], references: [id], onDelete: SetNull)
  wixCollectionId     String? // Wix collection ID for blog posts

  // Reddit OAuth
  redditOAuthTokenId String? // Reference to RedditOAuthToken
  redditOAuthToken   RedditOAuthToken? @relation(fields: [redditOAuthTokenId], references: [id], onDelete: SetNull)
  redditSubreddit    String? // Target subreddit for posts

  // Medium OAuth
  mediumOAuthTokenId  String? // Reference to MediumOAuthToken
  mediumOAuthToken    MediumOAuthToken? @relation(fields: [mediumOAuthTokenId], references: [id], onDelete: SetNull)
  mediumPublicationId String? // Optional: publish to a Medium publication

  connectionName String?
  lastSyncAt     DateTime?
  lastError      String?
  lastErrorAt    DateTime?
  errorCount     Int       @default(0)
  isVerified     Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publishedBlogs PublishedBlog[]

  @@unique([userId, platform, businessId])
  @@index([businessId])
  @@index([userId, businessId])
  @@index([userId])
  @@index([platform])
}

model PublishedBlog {
  id            String                @id @default(uuid())
  blogId        String
  blog          Blog                  @relation(fields: [blogId], references: [id], onDelete: Cascade)
  integrationId String
  integration   PublishingIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  platform        ConnectionPlatform
  externalPostId  String?
  externalPostUrl String?

  status        PublishStatus @default(PENDING)
  publishStatus String?

  publishedAt  DateTime?
  lastSyncedAt DateTime?
  lastError    String?
  retryCount   Int       @default(0)

  platformResponse Json?

  publishingStartedAt  DateTime?
  lastPublishAttemptId String?
  publishLockExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([blogId, integrationId])
  @@index([blogId])
  @@index([platform])
  @@index([status])
  @@index([publishedAt])
}

enum STATUS {
  DRAFT
  PUBLISH
}

model CustomField {
  id           String   @id @default(uuid())
  reading_time String
  rating       Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Blog         Blog[]
}

model Meta {
  id              String   @id @default(uuid())
  seo_title       String
  seo_description String
  focus_keyword   String
  keywords        String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Blog Blog[]
}

model Blog {
  id                   String   @id @default(uuid())
  title                String
  slug                 String
  status               STATUS   @default(DRAFT)
  content              String
  excerpt              String
  categories           String[]
  tags                 String[]
  featured_media       String
  blogPublishTime      String
  blogPublishDate      String
  seoScore             Int? // SEO score (0-100) calculated on frontend
  analytics            Json? // LLM-generated analytics: content quality, ranking potential, conversion potential, external links count
  onboardingPreviewKey String?  @unique

  // 🆕 SEO 2026: Author E-E-A-T fields
  authorName  String?
  authorBio   String?
  authorUrl   String?
  authorImage String?

  // 🆕 SEO 2026: Content cluster
  clusterId   String?
  cluster     ContentCluster? @relation(fields: [clusterId], references: [id])
  clusterRole String? // "pillar" or "cluster"

  // 🆕 B1: Content freshness loop
  lastRefreshedAt      DateTime?
  refreshAttempts      Int       @default(0)
  // 🆕 B3: Citation verifier output
  verificationFailures Json? // [{url, reason, strippedAt}]
  // 🆕 C4: Canonical URL when republished to customer's WordPress/Shopify.
  // When set, our hosted copy emits <link rel="canonical" href=...> to point at the customer's domain.
  canonicalUrl         String?

  meta                     Meta                    @relation(fields: [metaId], references: [id], onDelete: Cascade)
  customField              CustomField             @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  user                     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  business                 Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  // Last time this blog's vector was (re)embedded into Pinecone.
  // NULL = never indexed by the background re-index job.
  // The weekly re-index job re-embeds blogs where updatedAt > pineconeIndexedAt.
  pineconeIndexedAt        DateTime?
  metaId                   String                  @unique
  customFieldId            String                  @unique
  userId                   String
  businessId               String
  Plan                     Plan[]
  GeneratedImages          GeneratedImage[]
  publishedBlogs           PublishedBlog[]
  outboundManagedBacklinks Backlinks[]             @relation("SourceBlogBacklinks")
