// ============================================
// Guest Posting Models
// ============================================

model GuestPostPublisher {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Publisher Info
  name       String
  websiteUrl String
  domain     String
  niche      String? // e.g., "SEO", "Marketing", "Tech"

  // Metrics (from DataForSEO or manual entry)
  domainAuthority Int? // DA score (0-100)
  domainRank      Int? // DR score
  monthlyTraffic  Int? // Estimated monthly visitors
  spamScore       Int? // 0-100 (lower is better)

  // Contact Info
  contactEmail         String?
  contactName          String?
  submissionUrl        String?
  submissionGuidelines String?
  acceptedFormats      String[] // ["HTML", "Markdown", "Word"]

  // Guest Post Requirements
  minWordCount     Int? // Minimum words required
  maxWordCount     Int? // Maximum words allowed
  requiresPayment  Boolean  @default(false)
  priceRange       String? // e.g., "$50-$150"
  acceptsLinks     Boolean  @default(true)
  maxLinksPerPost  Int? // Maximum backlinks allowed
  linkTypesAllowed String[] // ["dofollow", "nofollow", "sponsored"]

  // Status
  isActive       Boolean   @default(true)
  responseTime   String? // e.g., "2-3 days", "1 week"
  acceptanceRate Float? // 0-1 (percentage)
  isSuggested    Boolean   @default(false) // Whether this is a new suggestion from auto-discovery
  suggestedAt    DateTime? // When this publisher was suggested to the user

  // Metadata
  source        String  @default("MANUAL") // "MANUAL" | "MARKETPLACE" | "COMPETITOR_ANALYSIS" | "REDDIT" | "MEDIUM" | "AI_DISCOVERED"
  marketplaceId String? // ID from marketplace API
  notes         String?

  // Discovery Metadata
  discoveryMetadata     Json? // Store discovery source data (Reddit post, Medium publication, etc.)
  aiConfidenceScore     Float? // 0-1 score from AI analysis
  aiExtractedGuidelines String? // Guidelines extracted by AI
  lastDiscoveredAt      DateTime? // When this publisher was discovered
  isVerified            Boolean   @default(false) // Whether publisher has been verified
  verificationMethod    String? // "AI" | "MANUAL" | "SCRAPED"
  qualityScore          Float?
  qualityGateStatus     String    @default("PENDING") // "QUALIFIED" | "NEEDS_REVIEW" | "BLOCKED" | "PENDING"
  qualityGateReasons    String[]  @default([])
  complianceNotes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  submissions GuestPostSubmission[]

  @@unique([userId, websiteUrl])
  @@index([userId])
  @@index([domain])
  @@index([niche])
  @@index([isActive])
  @@index([domainAuthority])
}

model GuestPostCampaign {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Campaign Info
  name           String // e.g., "Q1 2025 SEO Guest Posting"
  description    String?
  targetKeywords String[] // Keywords to target in guest posts

  // Campaign Settings
  targetNiche           String? // Target niche/industry
  minDomainAuthority    Int? // Minimum DA filter
  maxPublisherSpamScore Int?    @default(15) // Maximum spam score for high-authority automation
  maxBudget             Float? // Maximum budget per post
  targetLinks           Int     @default(10) // Target number of links
  campaignTemplate      String  @default("STANDARD") // "STANDARD" | "HIGH_DR_GUEST_POSTING"

  // Status
  status    String    @default("DRAFT") // "DRAFT" | "ACTIVE" | "PAUSED" | "COMPLETED"
  startDate DateTime?
  endDate   DateTime?

  // Metrics (auto-calculated)
  totalPublishers Int @default(0)
  submissionsSent Int @default(0)
  accepted        Int @default(0)
  published       Int @default(0)
  rejected        Int @default(0)

  // Budget Tracking
  totalSpent Float @default(0)

  // Automation Settings
  autoCreateSubmissions     Boolean @default(false) // Auto-create submissions for matched publishers
  autoGeneratePitch         Boolean @default(false) // Auto-generate pitch emails
  autoSendPitch             Boolean @default(false) // Auto-send pitch emails after generation
  autoApprovePublishers     Boolean @default(false) // Auto-approve suggested publishers
  requireNicheMatch         Boolean @default(false)
  requireVerifiedPublishers Boolean @default(false)

  // Automation Schedule
  autoPitchDelayHours  Int? @default(0) // Delay before auto-sending pitch (0 = immediate)
  maxSubmissionsPerDay Int? @default(5) // Max submissions to create per day

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  submissions GuestPostSubmission[]

  @@index([userId])
  @@index([businessId])
  @@index([status])
  @@index([createdAt])
}

model GuestPostSubmission {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId  String?
  campaign    GuestPostCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  publisherId String
  publisher   GuestPostPublisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  blogId      String? // Link to generated blog if applicable
  blog        Blog?              @relation(fields: [blogId], references: [id], onDelete: SetNull)

  // Submission Details
  title         String
  proposedTopic String?
  pitchEmail    String?
  customContent String? // If different from blog

  // Status Tracking
  status          String    @default("DRAFT") // "DRAFT" | "PITCHED" | "ACCEPTED" | "REJECTED" | "PUBLISHED" | "EXPIRED"
  pitchSentAt     DateTime?
  respondedAt     DateTime?
  acceptedAt      DateTime?
  publishedAt     DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  // Email Tracking
  emailSentAt       DateTime?
  emailId           String? // Resend email ID
  emailOpenedAt     DateTime?
  emailClickedAt    DateTime?
  emailRepliedAt    DateTime?
  emailReplyContent String?
  emailTrackingId   String? // For webhook matching

  // Automation
  autoGeneratedPitch Boolean   @default(false)
  lastCheckedAt      DateTime? // For published post checking

  // Quality + compliance snapshot at creation time
  placementType      String   @default("EDITORIAL") // "EDITORIAL" | "SPONSORED" | "PAID"
  requiredLinkRel    String   @default("none") // "none" | "nofollow" | "sponsored"
  complianceStatus   String   @default("PENDING") // "PENDING" | "APPROVED" | "BLOCKED"
  complianceNotes    String?
  qualityScore       Float?
  qualityGateReasons String[] @default([])

  // Published Post Info
  publishedUrl      String?
  publishedTitle    String?
  backlinksReceived String[] // URLs of backlinks received

  // Cost
  cost     Float?
  currency String? @default("USD")

  // Notes
  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([campaignId])
  @@index([publisherId])
  @@index([status])
  @@index([blogId])
  @@index([publishedAt])
  @@index([emailSentAt])
  @@index([emailRepliedAt])
  @@index([status, emailSentAt])
  @@index([status, emailRepliedAt])
}

