{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "index.ts",
    "src/admin-api-config.ts",
    "src/types/**/*.d.ts",
    "tests/**/*.test.ts",
    // The command tests run in CI, so they are checked in CI. Without this they
    // ran but were never typechecked, and a test could drift from the signature
    // it was testing and still pass: `stageFromPaymentState("pending")` kept
    // asserting the old two-argument-free behaviour by passing `undefined` for
    // the argument that decides the answer. The rest of `src/tests` stays out —
    // it belongs to seo-be, is not run here, and does not typecheck clean.
    "src/tests/command-*.test.ts"
  ],
  "exclude": ["src/scripts"]
}
